#!/usr/bin/env python3
"""Build two native GPUI specimens from the revision in Mira's lockfile."""

import argparse
import fcntl
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import tempfile


HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
SAMPLE = "Accounts and combat profiles"
MANIFEST = """
[package]
name = "mira-font-comparison"
version = "0.1.0"
edition = "2024"
publish = false

[workspace]

[[bin]]
name = "mira-font-comparison"
path = "main.rs"

[dependencies]
anyhow = "1"
gpui = { path = "../zed/crates/gpui", default-features = false }
gpui_apple = { path = "../zed/crates/gpui_apple", features = ["font-kit"] }
gpui_platform = { path = "../zed/crates/gpui_platform", features = ["font-kit"] }

[profile.dev]
debug = 0

[profile.dev.package."*"]
opt-level = 3
"""


def output(*args):
    return subprocess.check_output(args, cwd=ROOT, text=True).strip()


def binaries():
    host = next(line[6:] for line in output("rustc", "-vV").splitlines() if line.startswith("host: "))
    metadata = json.loads(output("cargo", "metadata", "--locked", "--format-version", "1", "--filter-platform", host))
    apple = next(p for p in metadata["packages"] if p["name"] == "gpui_apple")
    rev = apple["source"].split("#")[-1]
    checkout = Path(apple["manifest_path"]).parents[2]
    cache = Path(metadata["target_directory"]) / "font-comparison"
    cache.mkdir(parents=True, exist_ok=True)
    digest = hashlib.sha256(output("rustc", "-vV").encode())
    for path in [HERE / x for x in ("compare", "main.rs", "measure.rs", "Inter.ttf", "gpui-apple.patch")] + [ROOT / "Cargo.lock"]:
        digest.update(path.read_bytes())
    result = cache / digest.hexdigest()[:16]

    with (cache / "build.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if result.is_dir():
            return result
        with tempfile.TemporaryDirectory(dir=cache) as scratch:
            work = Path(scratch)
            zed = work / "zed"
            subprocess.run(["git", "clone", "--quiet", "--local", "--no-checkout", checkout, zed], check=True)
            subprocess.run(["git", "-C", zed, "checkout", "--quiet", "--detach", rev], check=True)
            patch = HERE / "gpui-apple.patch"
            subprocess.run(["git", "-C", zed, "apply", "--check", patch], check=True)
            viewer = work / "viewer"
            viewer.mkdir()
            for name in ("main.rs", "measure.rs", "Inter.ttf"):
                shutil.copyfile(HERE / name, viewer / name)
            shutil.copyfile(ROOT / "Cargo.lock", viewer / "Cargo.lock")
            manifest = viewer / "Cargo.toml"
            manifest.write_text(MANIFEST)
            build = ["cargo", "build", "--quiet", "--manifest-path", manifest, "--target-dir", cache / "build"]
            staged = work / "binaries"
            staged.mkdir()
            for mode in ("Before", "After"):
                if mode == "After":
                    subprocess.run(["git", "-C", zed, "apply", patch], check=True)
                    build.append("--locked")
                print(f"Building {mode} at {rev[:8]}…", flush=True)
                subprocess.run(build, cwd=ROOT, check=True)
                shutil.copy2(cache / "build/debug/mira-font-comparison", staged / mode)
            staged.rename(result)
    return result


def rows(report):
    values = {}
    for line in report.splitlines():
        family, weight, size, width, *masks = line.split("\t")
        values[family, int(weight), int(size)] = (float(width), *masks)
    return values


def verify(bins):
    native = rows(output("swift", HERE / "reference.swift", HERE / "Inter.ttf", SAMPLE))
    before = rows(output(bins / "Before", "--measure"))
    after = rows(output(bins / "After", "--measure"))
    if after != rows(output(bins / "After", "--measure-owned")):
        raise SystemExit("Borrowed and owned font data produced different glyphs.")
    if len(native) != 12 or native.keys() != before.keys() or native.keys() != after.keys():
        raise SystemExit("A family, weight or size is missing.")
    print("Family          Weight  Size    Before     After    Native")
    for key in sorted(native):
        family, weight, size = key
        width, *masks = after[key]
        print(f"{family:15} {weight:5} {size:5} {before[key][0]:9.3f} {width:9.3f} {native[key][0]:9.3f}")
        if abs(width - native[key][0]) > 0.002:
            raise SystemExit(f"Width differs from Core Text at {key}.")
        if weight == 400 and before[key] != after[key]:
            raise SystemExit(f"Regular changed at {key}.")
        if weight > 400 and any(a == b for a, b in zip(masks, after[family, weight - 100, size][1:])):
            raise SystemExit(f"Adjacent weights produced identical glyph masks at {key}.")
    print("Both sizes match native widths. All three weights have distinct light and dark glyph masks.")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="compare widths and 2× glyph masks without opening windows")
    parser.add_argument("text", nargs="?", default=SAMPLE, help="text to display in both windows")
    args = parser.parse_args()
    bins = binaries()
    if args.check:
        verify(bins)
    else:
        for mode in ("Before", "After"):
            subprocess.Popen([bins / mode, mode, args.text], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("Opened Before and After. Each window renders both families in GPUI.")
