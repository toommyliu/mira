---
import { wrapIcon } from "../markdown.ts";
---

<button class="icon-button code-wrap" type="button" data-code-wrap aria-pressed="false" aria-label="Wrap lines">
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    {wrapIcon.map((d) => <path d={d} />)}
  </svg>
</button>
