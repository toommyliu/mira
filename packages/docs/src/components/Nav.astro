---
import { Package } from "lucide-static";

import type { NavSection } from "../nav.ts";

interface Props {
  sections: readonly NavSection[];
  current: string;
}

const { sections, current } = Astro.props;
---

<nav class="nav" aria-label="Documentation">
  {
    sections.map((section) => (
      <div class="nav-section">
        <h2>{section.title}</h2>
        <ul>
          {section.items.map((item) => (
            <li class={item.kind}>
              <a href={item.href} aria-current={item.href === current ? "page" : undefined}>
                {item.kind === "package" && <Fragment set:html={Package} />}
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</nav>
